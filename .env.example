# --- Main backend ---
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/library
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# --- Mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Chat service ---
CHAT_PORT=4100
CORS_ORIGIN=*

# --- RAG service ---
RAG_PORT=4200
OPENAI_API_KEY=
CHROMA_URL=http://localhost:8000
RAG_COLLECTION=library_docs

# --- Firebase Admin SDK (student portal Google sign-in) ---
# From Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- SSLCommerz (sandbox/developer mode only — fine payments) ---
# Store ID/Password from the sandbox dashboard at https://developer.sslcommerz.com
# IS_LIVE must stay false — this integration only targets the sandbox API.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# Publicly reachable base URL of this backend (used to build SSLCommerz
# success/fail/cancel/ipn callback URLs). On Render, this is the service's
# onrender.com URL; locally use a tunnel (ngrok/cloudflared) if you need to
# exercise the real IPN callback, since SSLCommerz can't reach localhost.
BACKEND_URL=http://localhost:4000

# Student frontend URL (already used for CORS above) — payment redirect
# handlers bounce the browser back here after checkout.
STUDENT_CLIENT_URL=