# --- Main backend ---
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/library
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# --- Mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Chat service ---
CHAT_PORT=4100
CORS_ORIGIN=*

# --- RAG service ---
RAG_PORT=4200
OPENAI_API_KEY=
CHROMA_URL=http://localhost:8000
RAG_COLLECTION=library_docs

# --- Book AI enrichment (description + topics generation) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
TAVILY_API_KEY=
# Upstash's Redis-protocol (TCP) endpoint, not the REST one used by UPSTASH_REDIS_REST_URL
REDIS_TCP_URL=
ENRICHMENT_MAX_ATTEMPTS=3
ENRICHMENT_STUCK_TIMEOUT_MS=600000